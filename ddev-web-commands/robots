#!/usr/bin/env bash
#ddev-silent-no-warn
#
# update-composer-robots.sh
#
# Updates composer.json to add a custom "robots" installer type/path and a
# drupal-scaffold file-mapping for a custom robots.txt, updates .gitignore,
# and requires the ubc-web-services/robots-custom package.
#
# Run this from the root of your Drupal project (where composer.json lives).

set -euo pipefail

COMPOSER_JSON="composer.json"
GITIGNORE=".gitignore"

# --- Sanity checks -----------------------------------------------------

if ! command -v jq >/dev/null 2>&1; then
  echo "Error: 'jq' is required but not installed. Install it (e.g. apt install jq / brew install jq) and re-run." >&2
  exit 1
fi

if ! command -v composer >/dev/null 2>&1; then
  echo "Error: 'composer' is required but not installed or not on PATH." >&2
  exit 1
fi

if [[ ! -f "$COMPOSER_JSON" ]]; then
  echo "Error: $COMPOSER_JSON not found in $(pwd). Run this script from your project root." >&2
  exit 1
fi

# --- Back up composer.json ---------------------------------------------

BACKUP="${COMPOSER_JSON}.bak.$(date +%Y%m%d%H%M%S)"
cp "$COMPOSER_JSON" "$BACKUP"
echo "Backed up $COMPOSER_JSON -> $BACKUP"

# --- Update composer.json with jq ---------------------------------------
#
# 1. extra.drupal-scaffold.file-mapping: merge in the robots.txt mapping
#    (won't clobber any existing file-mapping entries).
# 2. extra.installer-paths."assets/{$name}": add "type:robots" (creating
#    the array if it doesn't exist, without duplicating the entry).
# 3. extra.installer-types: append "robots" if not already present.

TMP_JSON="$(mktemp)"

jq '
  .extra["drupal-scaffold"]["file-mapping"] =
    ((.extra["drupal-scaffold"]["file-mapping"] // {}) + {
      "[web-root]/robots.txt": {
        "append": "assets/robots-custom/robots-custom.txt"
      }
    })
  |
  .extra["installer-paths"]["assets/{$name}"] =
    ((.extra["installer-paths"]["assets/{$name}"] // []) as $arr
      | if ($arr | index("type:robots")) then $arr else $arr + ["type:robots"] end)
  |
  .extra["installer-types"] =
    ((.extra["installer-types"] // []) as $arr
      | if ($arr | index("robots")) then $arr else $arr + ["robots"] end)
' "$COMPOSER_JSON" > "$TMP_JSON"

mv "$TMP_JSON" "$COMPOSER_JSON"
echo "Updated $COMPOSER_JSON (file-mapping, installer-paths, installer-types)"

# --- Update .gitignore ---------------------------------------------------

if [[ ! -f "$GITIGNORE" ]]; then
  touch "$GITIGNORE"
fi

if ! grep -qxF '/assets/' "$GITIGNORE"; then
  {
    # ensure we start on a new line if the file doesn't already end with one
    [[ -s "$GITIGNORE" && $(tail -c1 "$GITIGNORE") != "" ]] && echo
    echo "/assets/"
  } >> "$GITIGNORE"
  echo "Added /assets/ to $GITIGNORE"
else
  echo "$GITIGNORE already ignores /assets/, skipping"
fi

# --- Require the custom robots package -----------------------------------

echo "Running: composer require ubc-web-services/robots-custom:dev-master"
composer require ubc-web-services/robots-custom:dev-master

echo "Done."